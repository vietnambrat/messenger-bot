# Telegram: получить токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
# Своя случайная строка — Telegram будет присылать её в каждом webhook-запросе
TELEGRAM_WEBHOOK_SECRET=any-random-string-you-invent
# Только для локальной разработки без публичного HTTPS (long polling вместо webhook)
TELEGRAM_USE_POLLING=0

# Meta (Facebook Messenger + Instagram): developers.facebook.com
META_VERIFY_TOKEN=any-random-string-you-invent
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# Порт для локального/облачного сервера
PORT=5000
